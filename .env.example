# Transaction-mode pooler: production/serverless application traffic.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler: migrations and the persistent local development server.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Keep this small on Supabase Free; local development defaults to 2 when omitted.
DATABASE_POOL_SIZE="2"
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required for the Gmail Apps Script connector in production. Must be public HTTPS.
TASKFLOW_PUBLIC_URL="https://taskflow.example.com"
EMAIL_DELIVERY_MODE=log
EMAIL_FROM="TaskFlow <notifications@taskflow.local>"
EMAIL_DELIVERY_LOG_PATH="./var/email-delivery.jsonl"
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CRON_SECRET="replace-with-a-long-random-value"
